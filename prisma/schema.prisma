generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model CustomRole {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  permissions String[]
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  users       AppUser[]
}

model AppUser {
  id        String     @id @default(uuid())
  username  String     @unique
  email     String?
  fullName  String
  password  String
  roleId    String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  role      CustomRole @relation(fields: [roleId], references: [id])

  @@index([roleId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  details   String
  actorName String
  actorRole String
  createdAt DateTime @default(now())

  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model User {
  id                    String           @id @default(uuid())
  email                 String           @unique
  fullName              String
  phone                 String?
  role                  Role             @default(MANAGER)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  createdExpenses       CompanyExpense[] @relation("ExpenseCreator")
  createdSites          Site[]           @relation("SiteCreator")
  createdSiteIncomes    SiteIncome[]     @relation("SiteIncomeCreator")
  createdVendorPayments VendorPayment[]  @relation("VendorPaymentCreator")
  createdPurchases      VendorPurchase[] @relation("PurchaseCreator")
  createdWorkerPayments WorkerPayment[]  @relation("WorkerPaymentCreator")
  createdWorkLogs       WorkerWorkLog[]  @relation("WorkLogCreator")
}

model Site {
  id              String           @id @default(uuid())
  name            String
  clientName      String
  location        String?
  status          SiteStatus       @default(ACTIVE)
  estimatedBudget Decimal          @default(0.00) @db.Decimal(12, 2)
  openingBalance  Decimal          @default(0.00) @db.Decimal(12, 2)
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  companyExpenses CompanyExpense[]
  createdBy       User?            @relation("SiteCreator", fields: [createdById], references: [id])
  siteIncomes     SiteIncome[]
  vendorPayments  VendorPayment[]
  vendorPurchases VendorPurchase[]
  workerWorkLogs  WorkerWorkLog[]
}

model Vendor {
  id             String           @id @default(uuid())
  name           String
  phone          String?
  tradeCategory  String?
  notes          String?
  openingBalance Decimal          @default(0.00) @db.Decimal(12, 2)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  payments       VendorPayment[]
  purchases      VendorPurchase[]
}

model VendorPurchase {
  id           String   @id @default(uuid())
  vendorId     String
  siteId       String
  purchaseDate DateTime @default(now())
  amount       Decimal  @db.Decimal(12, 2)
  voucherNo    String?
  notes        String?
  createdById  String?
  createdAt    DateTime @default(now())
  createdBy    User?    @relation("PurchaseCreator", fields: [createdById], references: [id])
  site         Site     @relation(fields: [siteId], references: [id])
  vendor       Vendor   @relation(fields: [vendorId], references: [id])

  @@index([siteId])
  @@index([vendorId])
}

model VendorPayment {
  id          String      @id @default(uuid())
  vendorId    String
  siteId      String?
  paymentDate DateTime    @default(now())
  amount      Decimal     @db.Decimal(12, 2)
  paymentMode PaymentMode @default(CASH)
  voucherNo   String?
  notes       String?
  createdById String?
  createdAt   DateTime    @default(now())
  createdBy   User?       @relation("VendorPaymentCreator", fields: [createdById], references: [id])
  site        Site?       @relation(fields: [siteId], references: [id])
  vendor      Vendor      @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([siteId])
}

model Worker {
  id               String                 @id @default(uuid())
  name             String
  phone            String?
  trade            String?
  compensationType WorkerCompensationType @default(DAILY_WAGE)
  defaultDailyWage Decimal                @default(0.00) @db.Decimal(10, 2)
  monthlySalary    Decimal?               @db.Decimal(10, 2)
  openingBalance   Decimal                @default(0.00) @db.Decimal(10, 2)
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  companyExpenses  CompanyExpense[]
  salarySlips      SalarySlip[]
  payments         WorkerPayment[]
  workLogs         WorkerWorkLog[]
}

model WorkerWorkLog {
  id          String   @id @default(uuid())
  workerId    String
  siteId      String
  workDate    DateTime @default(now())
  wageAmount  Decimal  @db.Decimal(10, 2)
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  createdBy   User?    @relation("WorkLogCreator", fields: [createdById], references: [id])
  site        Site     @relation(fields: [siteId], references: [id])
  worker      Worker   @relation(fields: [workerId], references: [id])

  @@unique([workerId, siteId, workDate])
  @@index([workerId])
  @@index([siteId])
}

model WorkerPayment {
  id          String      @id @default(uuid())
  workerId    String
  paymentDate DateTime    @default(now())
  amount      Decimal     @db.Decimal(10, 2)
  paymentMode PaymentMode @default(CASH)
  voucherNo   String?
  notes       String?
  createdById String?
  createdAt   DateTime    @default(now())
  createdBy   User?       @relation("WorkerPaymentCreator", fields: [createdById], references: [id])
  worker      Worker      @relation(fields: [workerId], references: [id])

  @@index([workerId])
}

model SiteIncome {
  id           String      @id @default(uuid())
  siteId       String
  incomeDate   DateTime    @default(now())
  amount       Decimal     @db.Decimal(12, 2)
  paymentMode  PaymentMode @default(BANK_TRANSFER)
  referenceNo  String?
  receivedFrom String?
  notes        String?
  createdById  String?
  createdAt    DateTime    @default(now())
  createdBy    User?       @relation("SiteIncomeCreator", fields: [createdById], references: [id])
  site         Site        @relation(fields: [siteId], references: [id])

  @@index([siteId])
}

model CompanyExpense {
  id          String          @id @default(uuid())
  siteId      String?
  workerId    String?
  category    ExpenseCategory @default(MISCELLANEOUS)
  expenseDate DateTime        @default(now())
  amount      Decimal         @db.Decimal(12, 2)
  paymentMode PaymentMode     @default(CASH)
  voucherNo   String?
  notes       String?
  createdById String?
  createdAt   DateTime        @default(now())
  createdBy   User?           @relation("ExpenseCreator", fields: [createdById], references: [id])
  site        Site?           @relation(fields: [siteId], references: [id])
  worker      Worker?         @relation(fields: [workerId], references: [id])

  @@index([siteId])
  @@index([workerId])
  @@index([expenseDate])
}

model SalarySlip {
  id                String      @id @default(uuid())
  slipNumber        String      @unique
  workerId          String
  workerName        String
  workerTrade       String
  monthYear         String
  monthLabel        String
  baseSalary        Decimal     @db.Decimal(10, 2)
  advanceDeductions Decimal     @default(0.00) @db.Decimal(10, 2)
  otherDeductions   Decimal?    @db.Decimal(10, 2)
  netPayableAmount  Decimal     @db.Decimal(10, 2)
  paymentMode       PaymentMode @default(BANK_TRANSFER)
  paymentDate       DateTime    @default(now())
  voucherNo         String?
  notes             String?
  createdAt         DateTime    @default(now())
  worker            Worker      @relation(fields: [workerId], references: [id])

  @@index([workerId])
  @@index([monthYear])
}

enum Role {
  OWNER
  MANAGER
  ACCOUNTANT
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
}

enum SiteStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
}

enum WorkerCompensationType {
  DAILY_WAGE
  MONTHLY_SALARY
}

enum ExpenseCategory {
  SALARY_ADVANCE
  ROOM_RENT
  PETROL_FUEL
  FUEL_TRAVEL
  OFFICE_OVERHEAD
  FOOD_TEA_REFRESHMENTS
  TEA_REFRESHMENTS
  MACHINERY_RENT
  EQUIPMENT_RENT
  SITE_PERMIT_FEES
  MISCELLANEOUS
  OUTSIDE_LABOR
}
